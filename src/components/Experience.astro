---
import fs from 'node:fs';
import path from 'node:path';
import type { Dict } from '../data/i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const hasImage = (src?: string) => !!src && fs.existsSync(path.join(process.cwd(), 'public', src));
---
<section id="experience" class="section" aria-labelledby="exp-title">
  <h2 id="exp-title" class="section-title">{t.experience.title}</h2>
  <ol class="relative ml-2 border-l border-line">
    {t.experience.items.map((job) => (
      <li class="mb-10 ml-6 last:mb-0">
        <span class="absolute -left-[7px] mt-2 h-3 w-3 rounded-full bg-accent ring-4 ring-bg" aria-hidden="true"></span>
        <div class="card">
          <h3 class="text-lg font-semibold">{job.role}</h3>
          <p class="font-mono text-sm text-accent">{job.company} · {job.period}</p>
          {'title' in job && <p class="mt-2 text-sm italic text-muted">{job.title}</p>}
          {'image' in job && hasImage(job.image as string) && (
            <figure class="group relative mt-3 max-w-sm overflow-hidden rounded-lg border border-line" tabindex="0">
              <img src={job.image as string} alt={job.title as string} loading="lazy" class="w-full" />
              {'imageHover' in job && <figcaption class="pointer-events-none absolute inset-0 flex items-center justify-center bg-bg/75 p-3 text-center text-lg font-semibold text-ink opacity-0 transition-opacity group-hover:opacity-100 group-focus:opacity-100">{job.imageHover}</figcaption>}
            </figure>
          )}
          {'video' in job && hasImage(job.video as string) && (
            <video src={job.video as string} class="mt-3 w-full rounded-lg border border-line" autoplay loop muted playsinline controls preload="metadata" aria-label={job.role}></video>
          )}
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-muted">
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
