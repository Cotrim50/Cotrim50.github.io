---
import type { Dict } from '../data/i18n/en';
import { projects } from '../data/profile';
import ProjectCard from './ProjectCard.astro';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section id="projects" class="section" aria-labelledby="proj-title">
  <h2 id="proj-title" class="section-title">{t.projects.title}</h2>
  <ul class="grid gap-4 md:grid-cols-3">
    {projects.map((p) => <ProjectCard t={t} project={p} />)}
  </ul>
</section>
