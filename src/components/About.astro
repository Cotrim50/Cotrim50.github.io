---
import type { Dict } from '../data/i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section id="about" class="section" aria-labelledby="about-title">
  <h2 id="about-title" class="section-title">{t.about.title}</h2>
  <div class="max-w-3xl space-y-4 text-muted">
    {t.about.text.map((p) => <p>{p}</p>)}
  </div>
</section>
