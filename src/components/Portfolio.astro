---
import type { Dict } from '../data/i18n/en';
import Base from '../layouts/Base.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Certificates from './Certificates.astro';
import Projects from './Projects.astro';
import Printing from './Printing.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
interface Props { t: Dict; path: string }
const { t, path } = Astro.props;
---
<Base t={t} path={path}>
  <Navbar t={t} />
  <main>
    <Hero t={t} />
    <About t={t} />
    <Experience t={t} />
    <Projects t={t} />
    <Skills t={t} />
    <Education t={t} />
    <Certificates t={t} />
    <Printing t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
</Base>
