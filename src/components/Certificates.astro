---
import type { Dict } from '../data/i18n/en';
import { certificates } from '../data/profile';
interface Props { t: Dict }
const { t } = Astro.props;
---
{certificates.length > 0 && (
  <section id="certificates" class="section" aria-labelledby="cert-title">
    <h2 id="cert-title" class="section-title">{t.certificates.title}</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {certificates.map((c) => (
        <li class="card">
          <h3 class="font-semibold">{c.title}</h3>
          <p class="font-mono text-sm text-accent">{c.issuer} · {c.year}</p>
          {(c.file || c.url) && <a class="mt-3 inline-block text-sm text-accent hover:underline" href={c.file ?? c.url} target="_blank" rel="noopener noreferrer">{t.certificates.view} ↗</a>}
        </li>
      ))}
    </ul>
  </section>
)}
