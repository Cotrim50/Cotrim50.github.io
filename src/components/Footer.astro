---
import type { Dict } from '../data/i18n/en';
import { profile } from '../data/profile';
interface Props { t: Dict }
const { t } = Astro.props;
---
<footer class="border-t border-line py-8 text-center font-mono text-xs text-muted">
  <p>© {new Date().getFullYear()} {profile.name}. {t.footer.rights}</p>
  <p class="mt-1">{t.footer.built}</p>
</footer>
